# Environment and secrets
.env
**/.env
**/*.env
*.key
*.pem
# Firebase Admin SDK service account keys (backend-only, never committed)
backend/firebase-*.json
backend/*service-account*.json
backend/*firebase-adminsdk*.json

# Python
**/__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/

# Node / build
node_modules/
**/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
.eslintcache
# NOTE: backend/alamaticz-zoho-mcp/dist/ is intentionally NOT ignored, since
# the Docker build copies it as-is rather than rebuilding from src/. It's now
# a clean build output of src/ (both were trimmed to just 11 tools: the 2
# this app's own code actually calls - create_records, search_records - plus
# 9 harmless read-only ones (get_records/get_record/get_fields/get_module/
# list_modules/get_roles/get_pipelines/get_users/get_org) kept for ad-hoc
# diagnostics. Every genuinely dangerous write tool - update, upsert, delete,
# convert_lead, add_tags, attach_link, upload_file - was removed from both
# src/ and dist/ entirely. Safe to run `npm run build` here again if you ever
# change src/.

# Logs and runtime data (recursive)
logs/
**/*.log
**/incoming/
**/uploads/
**/processing/
**/processed/
**/outputs/
**/verified_transcripts/

# IDE
.vscode/
.idea/
.claude/
